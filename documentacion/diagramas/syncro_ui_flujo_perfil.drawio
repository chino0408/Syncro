<mxfile host="app.diagrams.net">
  <diagram name="Flujo Interfaz - Perfil" id="ui-perfil">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="750" math="0" shadow="0" background="#163649">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Usuario entra a Perfil desde el nav. inferior o tocando su avatar en Home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=13;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="320" height="70" as="geometry" />
