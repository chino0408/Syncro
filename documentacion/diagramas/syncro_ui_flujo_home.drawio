        <mxCell id="b2" value="Toca avatar o pestaña &quot;Perfil&quot; (nav. inferior)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n4" target="ext2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3" value="Toca &quot;Ver mi tiquete&quot; o pestaña &quot;Tiquetes&quot; (nav. inferior)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n4" target="ext3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b3b" value="Toca &quot;Historial de viajes&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;dashed=1;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="n4" target="ext3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b4" value="Completa Origen/Destino y toca &quot;Buscar ruta&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n4" target="ext4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b5" value="Toca &quot;Reportar incidencia&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n4" target="ext5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b6" value="Toca &quot;Rutas favoritas&quot; o pestaña &quot;Rutas&quot; (nav. inferior)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n4" target="ext6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b7" value="Toca &quot;Ayuda&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n4" target="ext7"><mxGeometry relative="1" as="geometry"/></mxCell>

