<mxfile host="app.diagrams.net">
  <diagram name="Flujo Interfaz - Home" id="ui-home">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="820" math="0" shadow="0" background="#163649">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Usuario abre la app y llega a Home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=13;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="¿Tiene un&#10;Viaje Activo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0B101B;strokeColor=#1DCDF1;fontColor=#FFFFFF;fontFamily=Poppins;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="120" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n3a" value="Home muestra la tarjeta &quot;Próximo viaje&quot; con ruta, hora y botón &quot;Ver mi tiquete&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="260" y="260" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n3b" value="Home muestra un estado vacío: &quot;No tenés viajes próximos&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Home completo: buscador de rutas + accesos rápidos + navegación inferior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B0D4;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=13;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="480" y="400" width="340" height="90" as="geometry" />
        </mxCell>

        <!-- Destinos externos -->
