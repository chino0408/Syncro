<mxfile host="app.diagrams.net">
  <diagram name="Flujo Interfaz - Tiquetes v2" id="ui-tiquetes-v2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" math="0" shadow="0" background="#163649">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Usuario entra a Tiquetes desde el nav. inferior o toca &quot;Ver mi tiquete&quot; en Home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=13;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="¿Tiene&#10;Tiquetes&#10;Comprados?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0B101B;strokeColor=#1DCDF1;fontColor=#FFFFFF;fontFamily=Poppins;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="200" height="100" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="Muestra la lista de tiquetes comprados, ordenados del más próximo al menos próximo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B0D4;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="260" y="280" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Selecciona un tiquete de la lista" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="260" y="410" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="Se despliega el código QR y la información del viaje (ruta, hora, asiento)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="260" y="510" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="Continúa en flujo de Validación de Tiquete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;dashed=1;fontColor=#FFFFFF;fontFamily=Inter;fontStyle=2;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="260" y="630" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Muestra el mensaje: &quot;No hay próximo viaje&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;fontColor=#FFFFFF;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="680" y="280" width="300" height="70" as="geometry" />
        </mxCell>

        <!-- Nav inferior -->
        <mxCell id="ext1" value="Pantalla Home&#10;→ ver diagrama Home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;dashed=1;fontColor=#FFFFFF;fontFamily=Inter;fontStyle=2;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="680" y="410" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ext2" value="Pantalla Rutas&#10;→ ver diagrama Rutas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;dashed=1;fontColor=#FFFFFF;fontFamily=Inter;fontStyle=2;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="680" y="500" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ext3" value="Pantalla Perfil&#10;→ ver diagrama Perfil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;dashed=1;fontColor=#FFFFFF;fontFamily=Inter;fontStyle=2;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="680" y="590" width="300" height="70" as="geometry" />
