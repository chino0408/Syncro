<mxfile host="app.diagrams.net">
  <diagram name="Flujo Interfaz - Ayuda y Soporte" id="ui-ayuda">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="750" math="0" shadow="0" background="#163649">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Usuario entra a Ayuda y Soporte desde Home o desde Perfil" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=13;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="480" y="20" width="340" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Pantalla muestra: &quot;¿Cómo podemos ayudarte?&quot; con las opciones &quot;Reportar un problema&quot; y &quot;Comenzar&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B0D4;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="460" y="140" width="380" height="90" as="geometry" />
        </mxCell>

        <!-- Reportar un problema -->
        <mxCell id="n3" value="Se abre un formulario: completa su información y describe el problema con la compra del tiquete" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="Toca &quot;Enviar reporte&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="El reporte se envía a soporte: &quot;Tu reporte fue enviado, quedás en espera de respuesta&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B0D4;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="540" width="320" height="90" as="geometry" />
        </mxCell>

        <!-- Comenzar -->
        <mxCell id="n6" value="Se abre una introducción: qué es Syncro y cómo funciona la app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="480" y="300" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="Toca &quot;Ver información de rutas&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="480" y="420" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ext_rutas" value="Pantalla Rutas: horarios, paradas y precios de cualquier ruta&#10;→ ver diagrama Rutas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;dashed=1;fontColor=#FFFFFF;fontFamily=Inter;fontStyle=2;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ext_home" value="Pantalla Home&#10;→ ver diagrama Home" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163649;strokeColor=#1DCDF1;dashed=1;fontColor=#FFFFFF;fontFamily=Inter;fontStyle=2;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="900" y="300" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- Conexiones -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1DCDF1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_reportar" value="Toca &quot;Reportar un problema&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1DCDF1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1DCDF1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_comenzar" value="Toca &quot;Comenzar&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n2" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1DCDF1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7ext" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1DCDF1;strokeWidth=2;endArrow=block;" edge="1" parent="1" source="n7" target="ext_rutas"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e6home" value="Toca &quot;Volver al Home&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#10B0D4;strokeWidth=2;endArrow=block;fontColor=#FFFFFF;fontFamily=Inter;fontSize=11;" edge="1" parent="1" source="n6" target="ext_home"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
