        <mxCell id="n6" value="Se quita de favoritas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=11;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="520" y="440" width="200" height="60" as="geometry" />
