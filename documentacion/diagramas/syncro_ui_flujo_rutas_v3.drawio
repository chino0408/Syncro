<mxfile host="app.diagrams.net">
  <diagram name="Flujo Interfaz - Rutas v3" id="ui-rutas-v3">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1150" math="0" shadow="0" background="#163649">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="Usuario llega a Rutas desde &quot;Buscar ruta&quot; en Home (origen/destino ya definidos) o desde la pestaña &quot;Rutas&quot; del nav. inferior" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="560" y="20" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="Rutas muestra el buscador, las pestañas &quot;Todas&quot; / &quot;Favoritas&quot;, la lista de rutas y el botón &quot;Mi ubicación&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#10B0D4;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Poppins;fontStyle=1;fontSize=12;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="560" y="150" width="400" height="90" as="geometry" />
        </mxCell>

        <!-- Buscador y favoritos (comportamiento local, no lleva a compra) -->
        <mxCell id="n3" value="La lista se filtra en tiempo real por nombre de ruta o parada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=11;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="La lista muestra solo las rutas marcadas con estrella" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=11;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="280" y="300" width="240" height="80" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="¿La Ruta&#10;ya era&#10;Favorita?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#0B101B;strokeColor=#1DCDF1;fontColor=#FFFFFF;fontFamily=Poppins;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="560" y="290" width="180" height="100" as="geometry" />
