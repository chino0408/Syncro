        <!-- Camino A: tocar una ruta de la lista -->
        <mxCell id="n9" value="Toca una ruta de la lista (sin búsqueda previa): Pantalla Detalle de Ruta con mapa, horarios, paradas y precio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=11;arcSize=16;" vertex="1" parent="1">
