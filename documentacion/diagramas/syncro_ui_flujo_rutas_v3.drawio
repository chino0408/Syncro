        <mxCell id="n8" value="Se abre un mapa mostrando la geolocalización del usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1DCDF1;strokeColor=#0B101B;fontColor=#0B101B;fontFamily=Inter;fontSize=11;arcSize=16;" vertex="1" parent="1">
          <mxGeometry x="1020" y="300" width="260" height="80" as="geometry" />
